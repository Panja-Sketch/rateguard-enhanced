# RateGuard backend -- local development environment (placeholders only; never commit a real .env).
# The application FAILS STARTUP if the AI values below are wrong (see app/core/runtime_config.py).

# --- GCP core ---------------------------------------------------------------
GCP_PROJECT_ID=rateguard-enhanced
GCP_REGION=us-central1
RATEGUARD_GOOGLE_CLOUD_PROJECT=rateguard-enhanced

# --- Vertex AI / Gemini (locked: docs/architecture/RATEGUARD_LOCKED_SOURCE_OF_TRUTH.md section 11) ---
# One canonical variable per concept. Vertex AI + Application Default Credentials only:
# there is NO Gemini API key. Do not set GEMINI_MODEL, GEMINI_API_KEY or GOOGLE_API_KEY.
RATEGUARD_GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_AI_LOCATION=us
GOOGLE_GENAI_USE_VERTEXAI=true
RATEGUARD_AGENT_ENABLED=true

# --- Operational guardrails (mandatory; validated at startup, ranges in brackets) ---
# Hard cap on Gemini calls in one mission [1-50]
RATEGUARD_MAX_GEMINI_CALLS_PER_MISSION=6
# Extra adaptive probe rounds Gemini may request [0-10]
RATEGUARD_MAX_PROBE_ROUNDS=1
# Extraction confidence strictly below this always requires human review, never PASS [0.5-1.0]
RATEGUARD_LOW_CONFIDENCE_REVIEW_THRESHOLD=0.60
# The old unprefixed names (MAX_GEMINI_CALLS_PER_MISSION, MAX_PROBE_ROUNDS,
# LOW_CONFIDENCE_REVIEW_THRESHOLD) are rejected at startup.

# --- Authentication / authorization ----------------------------------------
# Public Firebase project id (not a secret). Token verification uses Application
# Default Credentials -- run `gcloud auth application-default login` locally.
# No service-account JSON, no FIREBASE_ADMIN_KEY secret.
RATEGUARD_FIREBASE_PROJECT_ID=rateguard-enhanced
# The single challenge tenant the bootstrap script assigns users to.
RATEGUARD_CHALLENGE_TENANT_ID=rateguard-demo
# Leave UNSET so pre-tenant (legacy) records stay hidden from every user. To make
# existing demo records visible to the demo tenant, set it deliberately:
# RATEGUARD_LEGACY_RECORD_TENANT_ID=rateguard-demo

# --- Distributed rate limiting (per tenant + uid + operation; fixed window, Firestore-backed when deployed) ---
RATEGUARD_RATE_LIMIT_ENABLED=true
# Overrides as JSON: {"operation": "<limit>/<window_seconds>"}; unset = challenge defaults below.
# connector_test 5/h, mission_create 10/h (also retry), source_upload 30/h, source_compile 30/h,
# explanation_create 20/h, evidence_download 30/h, source_download 60/h
# RATEGUARD_RATE_LIMITS={"mission_create":"10/3600"}

# --- Web origin allowlist (JSON list; no wildcard) --------------------------
RATEGUARD_CORS_ORIGINS=["http://localhost:3000"]

# --- Which routes this process serves: all (local) | api | worker -----------
RATEGUARD_SERVICE_ROLE=all

# --- State / messaging / storage --------------------------------------------
RATEGUARD_RUN_STORE=memory
RATEGUARD_FIRESTORE_DATABASE=(default)
RATEGUARD_EXECUTION_MODE=local
PUBSUB_TOPIC_ID=assurance-runs
PUBSUB_SUBSCRIPTION_ID=assurance-runs-worker-sub
PUBSUB_DEAD_LETTER_TOPIC=assurance-runs-dead-letter
BIGQUERY_DATASET=rateguard_portfolio
BIGQUERY_PROJECT=rateguard-enhanced
GCS_BUCKET_NAME=rateguard-enhanced-artifacts

# --- Service accounts (identifiers only) ------------------------------------
API_SERVICE_ACCOUNT=rateguard-api-sa@rateguard-enhanced.iam.gserviceaccount.com
WORKER_SERVICE_ACCOUNT=rateguard-worker-sa@rateguard-enhanced.iam.gserviceaccount.com
WEB_SERVICE_ACCOUNT=rateguard-web-sa@rateguard-enhanced.iam.gserviceaccount.com

# --- Artifact Registry -------------------------------------------------------
ARTIFACT_REGISTRY_REPO=us-central1-docker.pkg.dev/rateguard-enhanced/rateguard-images
