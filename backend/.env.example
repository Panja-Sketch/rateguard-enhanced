# RateGuard AI Environment Configuration
RATEGUARD_APP_NAME="RateGuard AI Backend"
RATEGUARD_APP_VERSION="0.1.0"
RATEGUARD_DEBUG=true

# Google GenAI SDK & Gemini Configuration (Hackathon floor requirement: Gemini 3.5+)
RATEGUARD_GEMINI_MODEL="gemini-3.7-flash"
RATEGUARD_GEMINI_LOCATION="us-central1"
RATEGUARD_AGENT_ENABLED=true

# Storage Configuration
RATEGUARD_RUN_STORE="memory"
RATEGUARD_ARTIFACT_STORE="local"
RATEGUARD_GOOGLE_CLOUD_PROJECT="rateguard-ai"
RATEGUARD_GCS_BUCKET="rateguard-ai-artifacts"

