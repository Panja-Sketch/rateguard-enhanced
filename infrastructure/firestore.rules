rules_version = '2';

// RateGuard: Firestore is accessed ONLY by the API and worker through the
// Admin SDK / server client libraries, which bypass these rules. No browser
// client may read or write any document -- in particular users/{uid}, the
// server-controlled record that is the sole authority for role and tenant
// (docs/security/AUTHORIZATION_MATRIX.md).
//
// NOT deployed by any script in this repository. Publishing rules is a
// separate, reviewed step (e.g. `firebase deploy --only firestore:rules` from a
// directory whose firebase.json points here) and must precede any user-facing
// candidate exposure.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
